# Arxon Mining App — mobile web app environment variables
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# --- Supabase (Mining App project ONLY — oztccmrhiawleucdluwb) ---
# Never use the website project (knfpmzjghbjnlnarsivs).
VITE_SUPABASE_URL=https://oztccmrhiawleucdluwb.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Cloudflare Turnstile (bot protection on sign-up / sign-in) ---
# Public site key (safe for client). Also hard-fallbacked in src/lib/turnstile.ts so
# CI/host builds that omit `.env` still embed the key.
#
# In Cloudflare Turnstile → your widget → Hostnames, ADD ALL of:
#   arxonchain.xyz
#   www.arxonchain.xyz
#   arxon-mobile.pages.dev   ← Capacitor OTA WebView origin
#   localhost                ← bundled Capacitor / local vite
# (Adding a parent hostname also covers its subdomains; wildcards are NOT supported.)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAELKREYgfx_ebd18

# Turnstile SECRET (server-side only — never commit the real value):
# 1) Supabase Dashboard → Authentication → Attack Protection → CAPTCHA (sign-in / reset)
# 2) Supabase Dashboard → Edge Functions → Secrets → TURNSTILE_SECRET_KEY
#    (required for auth-signup / auth-recover — same secret as the site key above)
# Local dev only: ALLOW_SIGNUP_WITHOUT_TURNSTILE=true on the auth-signup function.

# --- Sentry (errors + session replay; optional locally) ---
# Create project at https://sentry.io — see docs/SENTRY_SETUP.md
# VITE_SENTRY_DSN=
# VITE_SENTRY_REPLAY_SAMPLE_RATE=0.1

# Deploy trigger: force OTA rebuild (2026-08-09 16:15 UTC+1).
