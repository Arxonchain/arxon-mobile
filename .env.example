# Arxon Mining App — mobile web app environment variables
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Vite only exposes variables prefixed with VITE_ to client-side code.

# --- Supabase ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Cloudflare Turnstile (bot protection on sign-up / sign-in) ---
# Create a Turnstile widget at https://dash.cloudflare.com/ -> Turnstile, for the
# arxonchain.xyz site, with Widget Mode = "Managed" (least user friction — it's
# invisible unless Cloudflare's risk engine decides a request needs a challenge).
# Paste the resulting Site Key below. If this is left unset, the app skips
# rendering the CAPTCHA entirely and auth flows behave exactly as before.
# Public site key (safe for client). Production OTA builds pick this up from
# the committed `.env` via GitHub Actions `npm run build` (deploy-web.yml).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAELKREYgfx_ebd18

# Note: the matching Turnstile SECRET key is NOT used by this app — it must be
# pasted into Supabase Dashboard -> Authentication -> Attack Protection -> Enable CAPTCHA
# protection, so GoTrue can verify the token server-side.
